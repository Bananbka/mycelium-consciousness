FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy

# Optional extras, e.g. --build-arg EXTRAS=gemini for live embeddings.
ARG EXTRAS=""

WORKDIR /app

COPY pyproject.toml uv.lock ./
COPY shared ./shared
COPY services ./services

RUN pip install --no-cache-dir uv && uv sync --package api --frozen --no-dev ${EXTRAS:+--extra $EXTRAS}

RUN useradd --create-home --uid 10001 app && chown -R app:app /app
USER app

EXPOSE 8000

CMD ["uv", "run", "--package", "api", "--frozen", "--no-sync", "api"]
