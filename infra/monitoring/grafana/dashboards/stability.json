      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "100 * sum(rate(http_request_duration_seconds_count{status=~\"5..\"}[1m])) / sum(rate(http_request_duration_seconds_count[1m])) or vector(0)",
          "legendFormat": "5xx %"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Container CPU (% of one core)",
      "datasource": {
        "type": "prometheus",
