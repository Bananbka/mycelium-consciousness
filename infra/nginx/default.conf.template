# Rendered by the nginx image's envsubst into /etc/nginx/conf.d/default.conf
# (only the variables listed in the environment are substituted, so nginx's own
# $host, $upstream_addr etc. are left alone).
#
# Lab 6: pool and algorithm come from LB_ALGORITHM and LB_SERVERS (see README).
# `server api:8000` resolves to the IP of every `api` replica at nginx startup,
# so restart nginx after scaling.
resolver 127.0.0.11 valid=10s ipv6=off;

upstream api_pool {
    # Shared memory: one round-robin counter and one failure state for all nginx
    # worker processes (without it each worker rotates on its own).
    zone api_pool 64k;
    ${LB_ALGORITHM}
    ${LB_SERVERS}
    keepalive 32;
    keepalive_requests 1000;
    keepalive_timeout 60s;
}

# Internal only (not published): scraped by nginx-prometheus-exporter.
server {
    listen 8081;
    location = /stub_status {
        stub_status;
    }
}

server {
    listen 80;

    # Prometheus scrapes the replicas directly on the internal network.
    location = /metrics {
        return 404;
    }

    location / {
        proxy_pass http://api_pool;

        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Which replica nginx actually picked (the API also sets X-Instance-ID).
        add_header X-Upstream-Addr $upstream_addr always;

        # Passive health check: a replica that refuses/times out is skipped
        # (max_fails/fail_timeout on the server line) and the request is retried
        # on another one. non_idempotent lets POST be retried too: a write frame
        # that hit a dying node may be duplicated, which append-only memory
        # tolerates.
        proxy_next_upstream error timeout http_502 http_503 http_504 non_idempotent;
        proxy_next_upstream_tries 3;
        proxy_connect_timeout 2s;
    }
}
