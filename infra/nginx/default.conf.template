resolver 127.0.0.11 valid=10s ipv6=off;

upstream api_pool {
    ${LB_ALGORITHM}
    ${LB_SERVERS}
    keepalive 32;
    keepalive_requests 1000;
    keepalive_timeout 60s;
}

server {
    listen 80;

    location / {
        proxy_pass http://api_pool;

        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # A 503 *from the application* means a dependency (primary DB, a shard)
        # is down, which another instance cannot fix. Counting it as an upstream
        # failure made max_fails take every instance out of rotation and turned
        # a read-only degradation into a total outage (lab 10), so it is not a
        # retry/failure condition; transport errors and gateway errors still are.
        proxy_next_upstream error timeout http_502 http_504 non_idempotent;
        proxy_next_upstream_tries 2;
        proxy_connect_timeout 2s;
    }
}
