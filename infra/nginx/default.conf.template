# Rendered by the nginx image's envsubst into /etc/nginx/conf.d/default.conf.
# Lab 3: switch algorithm / pool via LB_ALGORITHM and LB_SERVERS (see README).
resolver 127.0.0.11 valid=10s ipv6=off;

upstream api_pool {
    ${LB_ALGORITHM}
    ${LB_SERVERS}
    keepalive 32;
    keepalive_requests 1000;
    keepalive_timeout 60s;
}

server {
    listen 80;

    location / {
        proxy_pass http://api_pool;

        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Passive health check: a failed upstream is retried on another node.
        # non_idempotent lets POST be retried too: a write frame that hit a
        # dying node may be duplicated, which append-only memory tolerates.
        proxy_next_upstream error timeout http_502 http_503 http_504 non_idempotent;
        proxy_next_upstream_tries 2;
        proxy_connect_timeout 2s;
    }
}
