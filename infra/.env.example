# PostgreSQL
POSTGRES_USER=admin
POSTGRES_PASSWORD=secretpassword
POSTGRES_DB=clone_memory_db
POSTGRES_HOST=db
# In-network port. Leave at 5432; this is how services reach the db container.
POSTGRES_PORT=5432
# Host-side published port. Change this if something already owns 5432 locally.
POSTGRES_HOST_PORT=5432

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE=1800

# Redis / Celery
REDIS_HOST=redis
REDIS_PORT=6379
# Host-side published port. Change this if something already owns 6379 locally.
REDIS_HOST_PORT=6379
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_TASK_QUEUE=memory_batches

# Auth. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-me-with-at-least-32-random-bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=60

# Application
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=2
API_RELOAD=false
GRPC_PORT=50051
GRPC_SHUTDOWN_GRACE=10
GRPC_MAX_CONCURRENT_RPCS=512
LOG_LEVEL=INFO

# Semantic search
MEMORY_SEARCH_DEFAULT_LIMIT=10
MEMORY_SEARCH_MAX_LIMIT=50

# Ingestion micro-batching
INGEST_BATCH_FRAMES=64
INGEST_BATCH_BYTES=1048576

# External APIs. The Gemini provider is an optional extra: the images fall
# back to a local offline embedder unless built with
#   docker compose build --build-arg EXTRAS=gemini api celery-worker
GEMINI_API_KEY=replace-me
GEMINI_EMBEDDING_MODEL=text-embedding-004
