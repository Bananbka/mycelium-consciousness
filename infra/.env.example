# PostgreSQL
POSTGRES_USER=admin
POSTGRES_PASSWORD=secretpassword
POSTGRES_DB=clone_memory_db
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=5432

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE=1800

# Redis / Celery
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_HOST_PORT=6379
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_TASK_QUEUE=memory_batches

# How often celery-beat checks which clones are due for a backup rollup.
# Interval, not a cron: fine-grained enough for the daily/weekly/monthly
# tiers without needing per-tier schedules.
ROLLUP_CHECK_INTERVAL_SECONDS=3600

# How often celery-beat drains every clone's Redis stream into memory_entries.
STREAM_FLUSH_INTERVAL_SECONDS=60
# Per-clone safety valve: a write that pushes a stream's length to this many
# entries fires an immediate out-of-band flush instead of waiting.
MEMORY_STREAM_MAXLEN=10000

# Object storage (backups). Point MINIO_ENDPOINT at any S3-compatible service
# in production; MinIO here is the local dev/test stand-in.
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=memory-backups
MINIO_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001

# Auth. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-me-with-at-least-32-random-bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=60

# Application
API_HOST=0.0.0.0
API_PORT=8000
API_HOST_PORT=8000
API_WORKERS=2
API_RELOAD=false
LOG_LEVEL=INFO
