# PostgreSQL
POSTGRES_USER=admin
POSTGRES_PASSWORD=secretpassword
POSTGRES_DB=clone_memory_db
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=5432

# Lab 6: streaming-replication standby used for lag-tolerant reads. Empty
# POSTGRES_REPLICA_HOST disables the split (every read goes to the primary).
POSTGRES_REPLICA_HOST=db-replica
POSTGRES_REPLICA_HOST_PORT=5433
REPLICATION_USER=replicator
REPLICATION_PASSWORD=replicatorpass
REPLICATION_SLOT=replica1
# Window after a write during which that user's reads go to the primary
# (read-after-write). Must exceed the worst replication lag.
REPLICA_STICKY_SECONDS=5
REPLICA_BREAKER_COOLDOWN_SECONDS=5

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE=1800

# Redis / Celery
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_HOST_PORT=6379
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_TASK_QUEUE=memory_batches

# How often celery-beat checks which clones are due for a backup rollup.
# Interval, not a cron: fine-grained enough for the daily/weekly/monthly
# tiers without needing per-tier schedules.
ROLLUP_CHECK_INTERVAL_SECONDS=3600

# How often celery-beat drains every clone's Redis stream into memory_entries.
STREAM_FLUSH_INTERVAL_SECONDS=60
# Per-clone safety valve: a write that pushes a stream's length to this many
# entries fires an immediate out-of-band flush instead of waiting.
MEMORY_STREAM_MAXLEN=10000

# Object storage (backups). Point MINIO_ENDPOINT at any S3-compatible service
# in production; MinIO here is the local dev/test stand-in.
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=memory-backups
MINIO_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001

# Auth. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-me-with-at-least-32-random-bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=60

# Application
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=2
API_RELOAD=false
LOG_LEVEL=INFO

# Cache (lab 4): Redis db 1 by default (derived from CELERY_BROKER_URL, db 0)
CACHE_BACKUPS_TTL_SECONDS=60
CACHE_SOCKET_TIMEOUT_SECONDS=0.5

# Lab 7: data-plane sharding (memory_buffers / memory_backups keyed by clone_id).
# SHARD_NODES lists name=host[:port]; set it empty to run a single database.
# The order and names must be identical for every API/Celery process.
SHARD_NODES=a=shard-a:5432,b=shard-b:5432
SHARD_HOSTS=shard-a shard-b
# modulo | hash | vbucket
SHARD_STRATEGY=vbucket

# Lab 8: cache stampede / avalanche / penetration protection (guarded cache).
# none = unprotected cache-aside, lock = single-flight + Redis lock, swr = serve stale while refreshing
CACHE_PROTECTION=lock
CACHE_TTL_JITTER=0.1
LEADERBOARD_TTL_SECONDS=30
# none | negative | bloom | both
PENETRATION_GUARD=both
# 1 lets a request pick the mode via X-Cache-Protection / X-Penetration-Guard
# (experiments and demos only: it switches a safety mechanism off).
ALLOW_PROTECTION_OVERRIDE=0
