# PostgreSQL
POSTGRES_USER=admin
POSTGRES_PASSWORD=secretpassword
POSTGRES_DB=clone_memory_db
POSTGRES_HOST=db
POSTGRES_PORT=5432

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5

# Redis / Celery
REDIS_HOST=redis
REDIS_PORT=6379
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_TASK_QUEUE=memory_batches

# Application
API_PORT=8000
API_WORKERS=2
API_RELOAD=false
GRPC_PORT=50051
LOG_LEVEL=INFO

# Ingestion micro-batching
INGEST_BATCH_FRAMES=64
INGEST_BATCH_BYTES=1048576

# External APIs
GEMINI_API_KEY=replace-me
