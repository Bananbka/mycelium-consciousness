# PostgreSQL
POSTGRES_USER=admin
POSTGRES_PASSWORD=secretpassword
POSTGRES_DB=clone_memory_db
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=5432

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE=1800

# Redis / Celery
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_HOST_PORT=6379
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_TASK_QUEUE=memory_batches

# Auth. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-me-with-at-least-32-random-bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=60

# Application
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=2
API_RELOAD=false
GRPC_PORT=50051
GRPC_SHUTDOWN_GRACE=10
GRPC_MAX_CONCURRENT_RPCS=512
# gzip is per-message; below ~100 bytes it costs more than it saves. Off by
# default because example memory frames in this project are short. Set to
# "gzip" only if your real frames average noticeably longer than that.
GRPC_COMPRESSION=none
LOG_LEVEL=INFO

# Semantic search
MEMORY_SEARCH_DEFAULT_LIMIT=10
MEMORY_SEARCH_MAX_LIMIT=50

# Ingestion micro-batching
INGEST_BATCH_FRAMES=64
INGEST_BATCH_BYTES=1048576

# External API
GEMINI_API_KEY=replace-me
GEMINI_EMBEDDING_MODEL=text-embedding-004
